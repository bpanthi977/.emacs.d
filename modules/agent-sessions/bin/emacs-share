#!/bin/sh
# Hand a file, an external work link, or a workflow state to the human through
# agent-sessions.
#
#   emacs-share file FILE [DESCRIPTION]
#   emacs-share link linear|pr URL [LABEL]
#   emacs-share state STATE|--clear
#
# `emacs-share-file' is a compatibility symlink to this command.  When invoked
# under that name it keeps accepting the original FILE [DESCRIPTION] syntax.

set -u

program=$(basename -- "$0")

usage() {
  if [ "$program" = "emacs-share-file" ]; then
    echo "Usage: emacs-share-file FILE [DESCRIPTION]"
  else
    echo "Usage: emacs-share file FILE [DESCRIPTION]"
    echo "       emacs-share link linear|pr URL [LABEL]"
    echo "       emacs-share state STATE|--clear"
  fi
}

# The full help.  The states are bp/agent-sessions-states in Emacs, in the
# order the dashboard's `t' cycles them; a test keeps this list in step.
help() {
  usage
  cat <<'EOF'

Hand something to the human in their Emacs agent dashboard.  It attaches to
this terminal's session row and stays highlighted until they look at it.
Works only inside an Emacs agent session terminal.

  file FILE [DESCRIPTION]
      Share a local file (a plan, report, generated output) with a one-line
      reason.  Re-run it on the same path after changing the file: that
      re-highlights the existing entry instead of adding another.

  link linear|pr URL [LABEL]
      Attach a Linear issue or GitHub PR URL to the session.  Sharing the
      same URL again keeps one row; a new LABEL marks it unread again.

  state STATE
  state --clear
      Set or clear the session's workflow state, shown in the dashboard's
      state column.  The human can change it too (key `t'); whoever writes
      last wins.  STATE is one of:

        TODO          not started yet
        PLANNING      the agent is writing a plan
        PLAN-REVIEW   the plan waits on the human
        IMPLEMENTING  the agent is implementing
        IMPL-REVIEW   the implementation waits on the human
        PR-OPEN       the PR is up and waits on the human
        AUTOFIX       the agent is fixing review-bot findings on its PR
        REVIEW        waiting on someone else to look
        DONE          finished, nothing pending
        BLOCKED       needs the human's attention before the agent can go on
        LEARN         finished, with something worth taking away

      Anything else is refused with the list Emacs accepts.

Examples:
  emacs-share file plan.md "Plan for review"
  emacs-share link pr https://github.com/org/repo/pull/123
  emacs-share state BLOCKED
EOF
}

die() { echo "$program: $1" >&2; exit 1; }

usage_error() {
  usage >&2
  echo "Run '$program --help' for what each command does and the states." >&2
  exit 2
}

need_session() {
  [ -n "${EMACS_AGENT_SESSION_ID:-}" ] ||
    die "not inside an Emacs agent session terminal"
  command -v emacsclient >/dev/null 2>&1 || die "emacsclient not found"
}

# Codex tool shells carry the durable thread identity even when the shared
# daemon retained another terminal's EMACS_AGENT_SESSION_ID.
agent_session_id=${CODEX_THREAD_ID:-${CODEX_SESSION_ID:-}}

# Escape a value for interpolation into an elisp string literal.
esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# Turn emacsclient's printed elisp string back into plain text.
unquote() {
  printf '%s' "$1" | sed -e 's/^"//' -e 's/"$//' \
    -e 's/\\n/\
/g' -e 's/\\t/	/g' -e 's/\\"/"/g' -e 's/\\\\/\\/g'
}

call() {
  share_reply=$(emacsclient -e "$1" 2>&1) ||
    die "could not reach Emacs: $share_reply"
  unquote "$share_reply"
}

if [ "$program" = "emacs-share-file" ]; then
  case "${1:-}" in
    -h|--help|"") usage >&2; exit 2 ;;
  esac
  mode=file
else
  mode=${1:-}
  case "$mode" in
    -h|--help|help) help; exit 0 ;;
    "") usage_error ;;
  esac
  shift
  # `emacs-share state --help' and the like: help, not a state named --help.
  case "${1:-}" in
    -h|--help) help; exit 0 ;;
  esac
fi

case "$mode" in
  file)
    [ $# -ge 1 ] || usage_error
    [ $# -le 2 ] || die "file accepts FILE and an optional DESCRIPTION"
    file=$1
    label=${2:-}
    [ -e "$file" ] || die "no such file: $file"

    # Absolutize without depending on realpath/readlink -f, which differ
    # across platforms.  The dashboard outlives the caller's working directory.
    file_dir=$(dirname -- "$file")
    file_base=$(basename -- "$file")
    absolute_dir=$(cd -- "$file_dir" 2>/dev/null && pwd -P) ||
      die "cannot resolve directory of: $file"
    case "$absolute_dir" in
      */) absolute_path="$absolute_dir$file_base" ;;
      *)  absolute_path="$absolute_dir/$file_base" ;;
    esac

    need_session
    output=$(call "(bp/agent-sessions-share-file \"$(esc "$EMACS_AGENT_SESSION_ID")\" \"$(esc "$absolute_path")\" \"$(esc "$label")\" \"$(esc "$agent_session_id")\")")
    case "$output" in
      Shared*) printf '%s\n' "$output" ;;
      *) die "$output" ;;
    esac
    ;;

  state)
    [ $# -eq 1 ] || usage_error
    state=$1
    [ "$state" = "--clear" ] && state=

    need_session
    output=$(call "(bp/agent-sessions-share-state \"$(esc "$EMACS_AGENT_SESSION_ID")\" \"$(esc "$state")\" \"$(esc "$agent_session_id")\")")
    case "$output" in
      State*) printf '%s\n' "$output" ;;
      *) die "$output" ;;
    esac
    ;;

  link)
    [ $# -ge 2 ] || usage_error
    [ $# -le 3 ] || die "link accepts KIND, URL, and an optional LABEL"
    kind=$1
    url=$2
    label=${3:-}

    need_session
    output=$(call "(bp/agent-sessions-share-link \"$(esc "$EMACS_AGENT_SESSION_ID")\" \"$(esc "$kind")\" \"$(esc "$url")\" \"$(esc "$label")\" \"$(esc "$agent_session_id")\")")
    case "$output" in
      Linked*) printf '%s\n' "$output" ;;
      *) die "$output" ;;
    esac
    ;;

  *)
    die "unknown share type: $mode (try '$program help')"
    ;;
esac
